[core]
	editor = vim
	autocrlf = input
	eol = lf
	whitespace = cr-at-eol
[user]
	email = ixahedron@users.noreply.github.com
	name = Ilona
[push]
	default = simple
  autoSetupRemote = true
[alias]
  uncommit = reset HEAD^
	unamend = reset --soft HEAD@{1}
[rebase]
	autosquash = true
	autostash = true
[includeIf "gitdir:~/dev/serokell/"]
  path = ~/.gitconfig-serokell
[includeIf "gitdir:~/dev/yatima/"]
  path = ~/.gitconfig-yatima
[includeIf "gitdir:~/dev/lurk-lab/"]
  path = ~/.gitconfig-lurk-lab
[includeIf "gitdir:~/dev/geosurge/"]
  path = ~/.gitconfig-geosurge
[init]
	defaultBranch = master
[rerere]
	enabled = true
